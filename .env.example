# Copy to .env and fill in your own values:
#     cp .env.example .env
#
# .env is gitignored. Never commit it.

# Database connection.
# Leave this unset (or delete the line) to run on SQLite with zero setup —
# the project will create and use data/blinkit_sim.db automatically.
#
# To use MySQL 8 instead, uncomment and fill in:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/blinkit_sim
DATABASE_URL=

# Random seed for synthetic data generation. Keep it fixed so results reproduce.
SEED=42
